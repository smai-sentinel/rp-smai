PORT=3000
# Optional invite password. Never use a password you use elsewhere.
ROOM_PASSWORD=
# Optional TURN server for voice across restrictive networks.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Comma-separated allowed website origins. No paths or trailing slashes.
PUBLIC_ORIGIN=


# Limit concurrent rooms on small servers.
MAX_ROOMS=4
# Frontend-only build settings. Leave empty when serving client and server together.
VITE_SERVER_URL=
BASE_PATH=/

# Private owner key. Never use VITE_ prefix or commit a real value.
ADMIN_TOKEN=
